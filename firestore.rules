rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helper functions
    // ---------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Admin check: trusts isAdmin field stored in the user document.
    // The write rules below prevent normal users from setting that field themselves.
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Bootstrap admin UIDs — always trusted as admins regardless of their document.
    function isBootstrapAdmin() {
      return request.auth != null && request.auth.uid in [
        "DNDjKZRt0yQNh4d3inNchRcs0oY2",
        "zCINcUAy84aMwHF83wlRUTO2Dn32",
        "gn2AlkdswANjVg58rUXOLoPaX192",
        "b7QYLqpUCNbCKGvU1SQgr1pHBJj1"
      ];
    }

    function isTrustedAdmin() {
      return isBootstrapAdmin() || isAdmin();
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStaff() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (
               isTrustedAdmin() ||
               getUserRole() in ['admin', 'editor', 'moderator']
             );
    }

    // True when the incoming write does NOT touch privileged fields.
    function notChangingPrivilegedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['isAdmin', 'isBlocked', 'role']);
    }

    // ---------------------------------------------------------------
    // Artifacts (guide data and other public content)
    // ---------------------------------------------------------------

    match /artifacts/{artifactId} {
      allow read: if true;
      allow write: if isTrustedAdmin();
      match /{document=**} {
        allow read: if true;
        allow write: if isTrustedAdmin();
      }
    }

    // ---------------------------------------------------------------
    // Users
    // ---------------------------------------------------------------

    match /users/{userId} {
      allow read: if true;

      // Anyone can create their own user document during sign-up/sign-in,
      // but they cannot give themselves admin, blocked, or elevated role fields.
      allow create: if isAuthenticated() && isOwner(userId) && (
        isTrustedAdmin() ||
        (
          !('isAdmin' in request.resource.data) &&
          !('isBlocked' in request.resource.data) &&
          !(request.resource.data.get('role', 'author') in ['admin', 'editor', 'moderator'])
        )
      );

      // Users can update their own profile but cannot change privileged fields.
      // Admins can update any profile (including setting isAdmin / role).
      allow update: if isAuthenticated() && (
        (isOwner(userId) && notChangingPrivilegedFields()) ||
        isTrustedAdmin()
      );

      allow delete: if isTrustedAdmin();

      // Sub-collections (packing lists, bookmarks, etc.)
      match /{subcollection}/{document} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isTrustedAdmin());
      }
    }

    // ---------------------------------------------------------------
    // Profiles / UserProfiles (legacy compatibility)
    // ---------------------------------------------------------------

    match /profiles/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isOwner(userId) || isTrustedAdmin());
    }

    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isOwner(userId) || isTrustedAdmin());
    }

    // ---------------------------------------------------------------
    // Posts — editorial review pipeline
    // ---------------------------------------------------------------

    match /posts/{postId} {
      // Public: approved only. Authors: own posts. Staff / assigned editor: all.
      allow read: if resource.data.status == 'approved'
                  || (isAuthenticated() && (
                      request.auth.uid == resource.data.authorId
                      || request.auth.uid == resource.data.get('assignedEditorId', '')
                      || isStaff()
                  ));

      // Authors can create posts, but cannot self-approve or self-feature.
      allow create: if isAuthenticated() && (
        isTrustedAdmin() ||
        (
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.get('status', 'pending') in ['pending', 'draft'] &&
          request.resource.data.get('isFeatured', false) == false
        )
      );

      // Staff may update review fields / status.
      // Authors may edit content when draft or changes_requested (and may resubmit to pending).
      allow update: if isAuthenticated() && (
        isTrustedAdmin() ||
        isStaff() ||
        (
          request.auth.uid == resource.data.authorId &&
          resource.data.status in ['draft', 'changes_requested', 'pending', 'rejected'] &&
          request.resource.data.get('status', resource.data.status) in ['draft', 'pending', 'changes_requested'] &&
          request.resource.data.get('isFeatured', false) == false &&
          request.resource.data.authorId == resource.data.authorId
        )
      );

      allow delete: if isAuthenticated() && (
        isTrustedAdmin() ||
        isStaff() ||
        (resource.data.authorId == request.auth.uid && resource.data.status == 'draft')
      );
    }

    // ---------------------------------------------------------------
    // In-app notifications
    // ---------------------------------------------------------------

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow update: if isAuthenticated()
                    && resource.data.recipientId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Mail trigger queue (Firebase Trigger Email extension)
    // ---------------------------------------------------------------

    match /mail/{mailId} {
      allow create: if isStaff();
      allow read, update, delete: if false;
    }

    // ---------------------------------------------------------------
    // Gallery Photos
    // ---------------------------------------------------------------

    match /galleryPhotos/{photoId} {
      allow read: if true;

      // Uploaders can create, but cannot self-approve or self-highlight.
      allow create: if isAuthenticated() && (
        isTrustedAdmin() ||
        (
          request.resource.data.uploaderId == request.auth.uid &&
          request.resource.data.get('status', 'pending') == 'pending' &&
          request.resource.data.get('isHighlighted', false) == false
        )
      );

      allow update: if isAuthenticated() && (
        isTrustedAdmin() ||
        isStaff() ||
        (
          resource.data.uploaderId == request.auth.uid &&
          resource.data.status in ['pending', 'rejected'] &&
          request.resource.data.get('status', resource.data.status) == resource.data.status &&
          request.resource.data.get('isHighlighted', false) == false
        )
      );

      allow delete: if isAuthenticated() && (
        isTrustedAdmin() ||
        isStaff() ||
        (resource.data.uploaderId == request.auth.uid && resource.data.status in ['pending', 'rejected'])
      );
    }

    // ---------------------------------------------------------------
    // Comments
    // ---------------------------------------------------------------

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (resource.data.authorId == request.auth.uid || isTrustedAdmin() || isStaff());
    }

    // ---------------------------------------------------------------
    // Reactions
    // ---------------------------------------------------------------

    match /reactions/{reactionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isTrustedAdmin());
    }

    // ---------------------------------------------------------------
    // Bookmarks (top-level collection)
    // ---------------------------------------------------------------

    match /bookmarks/{bookmarkId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isTrustedAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isTrustedAdmin());
    }

    // ---------------------------------------------------------------
    // Events
    // ---------------------------------------------------------------

    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isTrustedAdmin();
    }

    // ---------------------------------------------------------------
    // Contact form submissions
    // ---------------------------------------------------------------

    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isTrustedAdmin();
    }

    // ---------------------------------------------------------------
    // Waitlist
    // ---------------------------------------------------------------

    match /waitlist/{docId} {
      allow create: if true;
      allow read, update, delete: if isTrustedAdmin();
    }

    // ---------------------------------------------------------------
    // Admin audit log
    // ---------------------------------------------------------------

    match /admin_audit_log/{logId} {
      allow read, write: if isTrustedAdmin();
    }

    // ---------------------------------------------------------------
    // Analytics & Site Statistics
    // ---------------------------------------------------------------

    match /analytics_events/{eventId} {
      allow create: if true;
      allow read, delete: if isTrustedAdmin();
    }

    match /site_stats/{docId} {
      allow read, create, update: if true;
      allow delete: if isTrustedAdmin();
    }

    // ---------------------------------------------------------------
    // User checklists / packing lists (including collectionGroup)
    // ---------------------------------------------------------------

    match /userChecklists/{userId} {
      allow read, write: if isOwner(userId) || isTrustedAdmin();
    }

    match /{path=**}/packing/{docId} {
      allow read: if isTrustedAdmin();
    }
  }
}
