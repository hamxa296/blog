{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/guide.html", "destination": "/guide", "permanent": true },
    { "source": "/freshman-guide.html", "destination": "/guide", "permanent": true },
    { "source": "/freshman-guide", "destination": "/guide", "permanent": true },
    { "source": "/freshmanguide", "destination": "/guide", "permanent": true },
    { "source": "/freshman", "destination": "/guide", "permanent": true },
    { "source": "/freshmen", "destination": "/guide", "permanent": true },
    { "source": "/freshmen-guide", "destination": "/guide", "permanent": true },
    { "source": "/freshmen/(.*)", "destination": "/guide", "permanent": true },
    { "source": "/detail_packing_list.html", "destination": "/guide?section=what-to-pack", "permanent": true },
    { "source": "/packing-list", "destination": "/guide?section=what-to-pack", "permanent": true },
    { "source": "/packinglist", "destination": "/guide?section=what-to-pack", "permanent": true },
    { "source": "/dorm", "destination": "/guide?section=dorm-room-info", "permanent": true },
    { "source": "/hostel", "destination": "/guide?section=dorm-room-info", "permanent": true },
    { "source": "/societies", "destination": "/guide?section=societies-events", "permanent": true },
    { "source": "/contacts", "destination": "/guide?section=important-contacts", "permanent": true },
    { "source": "/browse.html", "destination": "/browse", "permanent": true },
    { "source": "/blogs", "destination": "/browse", "permanent": true },
    { "source": "/blog", "destination": "/browse", "permanent": true },
    { "source": "/posts", "destination": "/browse", "permanent": true },
    { "source": "/posts.html", "destination": "/browse", "permanent": true },
    { "source": "/post.html", "destination": "/browse", "permanent": true },
    { "source": "/post_display.html", "destination": "/browse", "permanent": true },
    { "source": "/archives/(.*)", "destination": "/browse", "permanent": true },
    { "source": "/gallery.html", "destination": "/gallery", "permanent": true },
    { "source": "/newgallery.html", "destination": "/gallery", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/map.html", "destination": "/map", "permanent": true },
    { "source": "/newmap.html", "destination": "/map", "permanent": true },
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/signup.html", "destination": "/signup", "permanent": true },
    { "source": "/profile.html", "destination": "/profile", "permanent": true },
    { "source": "/write.html", "destination": "/write", "permanent": true },
    { "source": "/newpost.html", "destination": "/write", "permanent": true },
    { "source": "/admin.html", "destination": "/cms", "permanent": true },
    { "source": "/admin-access.html", "destination": "/cms", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://apis.google.com https://vercel.live https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com wss://*.firebaseio.com https://api.cloudinary.com https://vercel.live https://*.vercel-insights.com https://vitals.vercel-insights.com https://va.vercel-scripts.com wss://ws-us3.pusher.com; frame-src 'self' https://*.firebaseapp.com https://vercel.live;"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
